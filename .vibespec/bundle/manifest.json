    "install_global.py",
    "update_global.py",
    "uninstall_global.py",
    "init_project.py",
    "doctor.py",
    "vibespec.py",
    "vibespec.cmd",
    "vibespec.sh",
    "vibespec_common.py",
    "install_global.ps1",
    "install_global.sh",
    "cloud_bundle.py",
    "bootstrap_github_repo.ps1",
    "bootstrap_github_repo.sh"
