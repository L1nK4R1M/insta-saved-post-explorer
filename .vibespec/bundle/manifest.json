      "vibespec-implementing-changes",
      "vibespec-verifying-completion",
      "vibespec-handing-off"
    ]
  },
  "skills": [
    "vibespec-routing-changes",
    "vibespec-discovering-codebases",
    "vibespec-clarifying-changes",
    "vibespec-modeling-domains",
    "vibespec-writing-specifications",
    "vibespec-designing-architecture",
    "vibespec-creating-tickets",
    "vibespec-implementing-changes",
    "vibespec-developing-with-tdd",
    "vibespec-diagnosing-bugs",
    "vibespec-reviewing-changes",
    "vibespec-verifying-completion",
    "vibespec-converging-docs",
    "vibespec-handing-off"
